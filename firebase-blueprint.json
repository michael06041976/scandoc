{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and enterprise preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "InvoiceDocument": {
      "title": "InvoiceDocument",
      "description": "Persisted invoice records with ERP sync status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "supplierName": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message exchanged with Gemini AI assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "model": { "type": "string" }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "InvoiceDocument",
      "description": "User invoice state and overrides"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages between user and Gemini chatbot"
    }
  }
}
